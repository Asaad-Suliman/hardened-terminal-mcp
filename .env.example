# Jail directory — REQUIRED (here or as jail_root in policy.toml).
HTMCP_JAIL_ROOT=/srv/htmcp/sandbox

# Path to the policy file.
HTMCP_POLICY_FILE=policy.toml

# Audit trail location — keep it OUTSIDE the jail root.
HTMCP_AUDIT_LOG=/var/log/htmcp/audit.jsonl

# "closed" = refuse to run if the record can't be written; "open" = run + warn.
HTMCP_AUDIT_FAIL_MODE=closed
